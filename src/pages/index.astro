---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StoryCard from '../components/StoryCard.astro';
import MediaCard from '../components/MediaCard.astro';
import StormTimeline from '../components/StormTimeline.astro';
import { SITE } from '../config';
import { url } from '../lib/url';
import Value from '../components/Value.astro';
import { getFeaturedStories, getMedia, getPhotos, TESTIMONY_KIND } from '../lib/content';

// Tide gauge illustration: a vertical scale in feet, 0 at y=240 and 14 at y=26 (15.28px a foot),
// drawn beside a 6-foot person for scale.
const gauge = Array.from({ length: 15 }, (_, ft) => ({ ft, y: 240 - ft * 15.28 }));

const featured = await getFeaturedStories(3);
const allPhotos = await getPhotos();
const photos = allPhotos.slice(0, 6);
const allMedia = await getMedia();
// Survivor testimonies have their own group on the Media page, so they stay out of this strip
const media = allMedia.filter((m) => m.data.kind !== TESTIMONY_KIND).slice(0, 3);
// Newsreel shown between the process steps and Featured voices
const video = allMedia.find((m) => m.data.youtube_id === 'OtGhDk3aJCA');
// Slides for the Photographs viewer; the script reads them from the page
const slides = photos.map((p) => ({
  id: p.id,
  href: url(`/photographs/${p.id}/`),
  src: url(p.data.image),
  alt: p.data.alt ?? p.data.title,
  title: p.data.title,
  caption: p.data.caption ?? '',
  date: p.data.date ?? '',
  credit: p.data.credit ?? '',
}));
const slidesJson = JSON.stringify(slides).replace(/</g, '\\u003c');

const steps = [
  { icon: 'mail', title: 'Get in touch', text: 'You tell us about yourself or a relative through the form or by email.' },
  { icon: 'mic', title: 'Record', text: 'We arrange an interview in the language the narrator prefers, in person, by phone or by video.' },
  { icon: 'pen', title: 'Transcribe', text: 'Volunteers transcribe the recording and, where needed, translate it into English.' },
  { icon: 'book', title: 'Publish', text: 'After review by a historian, the project lead adds the story to this archive, credited by name.' },
];

// Simple line icons (24×24, stroke only) for the process steps.
const icons: Record<string, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 6 9 7 9-7"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6"/>',
  pen: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13 7 4 4"/>',
  book: '<path d="M4 5h7a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H4zM20 5h-7a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h7z"/>',
};
---

<BaseLayout>
  <Hero />

  <!-- At a glance -->
  <section class="glance" aria-labelledby="glance-title">
    <div class="container">
      <h2 id="glance-title" class="label glance-title">At a glance</h2>
      <div class="glance-grid">
        <p class="glance-text">
          On <mark>Halloween 1961</mark>, Hurricane Hattie caused unimaginable devastation to Belize's Caribbean coast.
          The tide rose some <mark>14 feet</mark>, blew roofs off buildings, and caused the government to designate a
          new capital: <mark>Belmopan</mark>.
        </p>
        <figure class="gauge">
          <svg viewBox="0 0 320 260" role="img" aria-label="A gauge marked in feet, with the water line at 14 feet and a 6-foot person for scale">
            <line x1="70" y1="240" x2="70" y2="20" stroke="currentColor" stroke-width="2" />
            {gauge.map((g) => (
              <line x1={g.ft % 2 ? 58 : 50} y1={g.y} x2="70" y2={g.y} stroke="currentColor" stroke-width="2" />
            ))}
            {gauge.filter((g) => g.ft % 2 === 0).map((g) => (
              <text x="44" y={g.y + 4} class="gauge-num" text-anchor="end">{g.ft}</text>
            ))}
            <rect x="70" y="26" width="240" height="214" class="water" />
            <path d="M70 26 q15 -7 30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0 t30 0" class="wave" />
            <line x1="70" y1="240" x2="310" y2="240" stroke="currentColor" stroke-width="3" />
            <g fill="currentColor">
              <circle cx="190" cy="159" r="9" />
              <rect x="183" y="170" width="14" height="40" rx="4" />
              <rect x="183" y="208" width="6" height="32" />
              <rect x="191" y="208" width="6" height="32" />
            </g>
            <text x="226" y="150" class="gauge-num">6 ft person</text>
            <text x="210" y="20" class="gauge-14" text-anchor="middle">14 FT</text>
          </svg>
          <figcaption>Illustration: a tide of some 14 feet, shown against a person 6 feet tall.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- What this repository is -->
  <section class="band dark" aria-label="About this repository">
    <div class="container">
      <p class="band-text">
        This online repository brings together resources and primary source oral histories related to Hurricane Hattie.
      </p>
    </div>
  </section>

  <!-- Process -->
  <section class="section panel" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <h2 id="process-title">How a story reaches this archive</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-marker">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon]} />
              </span>
              <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="steps-note">
        Nothing sent to us appears on this site automatically.
      </p>
      <p><a class="btn" href={url('/get-involved/')}>Start with step one</a></p>
    </div>
  </section>

  <!-- Newsreel -->
  {video && (
    <section class="video-panel dark" aria-label="From the archive: newsreel">
      <div class="container">
        <figure>
          <div class="frame">
            <!-- youtube-nocookie.com: YouTube's privacy-enhanced mode, no tracking cookies until play -->
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${video.data.youtube_id}?rel=0`}
              title={`${video.data.title} (video)`}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <figcaption>
            <p class="eyebrow">From the archive</p>
            <p class="panel-caption">{video.data.title}</p>
            <p class="meta">{video.data.credit} Played from YouTube.</p>
            <p><a href={url(`/media/${video.id}/`)}>View this record</a></p>
          </figcaption>
        </figure>
      </div>
    </section>
  )}

  <!-- Featured voices -->
  <section class="section voices" aria-labelledby="voices-title">
    <div class="container">
      <div class="section-head">
        <h2 id="voices-title"><span class="quote-mark" aria-hidden="true">“</span>Featured voices</h2>
        <a class="label" href={url('/stories/')}>All stories →</a>
      </div>
      {featured.length > 0 ? (
        <ul class="card-grid">
          {featured.map((s) => (
            <li>
              <StoryCard
                href={url(`/stories/${s.id}/`)}
                title={s.data.title}
                narrator={s.data.narrator.name}
                type={s.data.type}
                place={s.data.location_1961}
                languages={s.data.languages}
                quote={s.data.featured_quote?.text}
                summary={s.data.summary}
              />
            </li>
          ))}
        </ul>
      ) : (
        <div class="pending">
          <p><em>We are actively transcribing oral histories from the Belize National Library Service Information System and recording new interviews of our own. <a href={url('/get-involved/')}>Share your story.</a></em></p>
          <a class="btn" href={url('/get-involved/')}>Share your story</a>
        </div>
      )}
    </div>
  </section>

  <!-- Photographs -->
  <section class="section dark photos-stage" aria-labelledby="photos-title">
    <div class="container">
      <div class="section-head">
        <h2 id="photos-title">Photographs</h2>
        <a class="label" href={url('/photographs/')}>Explore gallery →</a>
      </div>
      {slides.length > 0 && (
        <div data-stage>
          <div class="stage" tabindex="0" aria-label="Photograph viewer. Use the left and right arrow keys to move between photographs.">
            <button type="button" class="arrow prev" aria-label="Previous photograph" data-prev hidden>‹</button>
            <img src={slides[0].src} alt={slides[0].alt} data-img decoding="async" />
            <button type="button" class="arrow next" aria-label="Next photograph" data-next hidden>›</button>
          </div>
          <div class="stage-cap" aria-live="polite">
            <div>
              <p class="mono-line" data-meta>{slides[0].id}{slides[0].date && ` · ${slides[0].date}`}</p>
              <p class="stage-title" data-title>{slides[0].title}</p>
              <p class="stage-text" data-text>{slides[0].caption} {slides[0].credit}</p>
              <p><a href={slides[0].href} data-link>View this record</a></p>
            </div>
            <p class="mono-line" data-count hidden></p>
          </div>
          <div class="dots" data-dots></div>
          <script type="application/json" id="slides-data" set:html={slidesJson} />
        </div>
      )}
    </div>
  </section>

  <script>
    // One photograph at a time, with arrows, the arrow keys and a progress bar.
    // Without JavaScript the first photograph shows, and the gallery link reaches the rest.
    const root = document.querySelector<HTMLElement>('[data-stage]');
    const data = document.getElementById('slides-data');
    if (root && data) {
      type Slide = { id: string; href: string; src: string; alt: string; title: string; caption: string; date: string; credit: string };
      const slides: Slide[] = JSON.parse(data.textContent ?? '[]');
      const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
      const img = q<HTMLImageElement>('[data-img]');
      const [prev, next] = [q<HTMLButtonElement>('[data-prev]'), q<HTMLButtonElement>('[data-next]')];
      const count = q('[data-count]');
      const dots = q('[data-dots]');
      let i = 0;

      slides.forEach((s, k) => {
        const d = document.createElement('button');
        d.type = 'button';
        d.setAttribute('aria-label', `Photograph ${k + 1}: ${s.title}`);
        d.addEventListener('click', () => show(k));
        dots.append(d);
      });

      function show(n: number) {
        i = (n + slides.length) % slides.length;
        const s = slides[i];
        img.src = s.src;
        img.alt = s.alt;
        q('[data-meta]').textContent = s.date ? `${s.id} · ${s.date}` : s.id;
        q('[data-title]').textContent = s.title;
        q('[data-text]').textContent = `${s.caption} ${s.credit}`.trim();
        q<HTMLAnchorElement>('[data-link]').href = s.href;
        count.textContent = `${i + 1} / ${slides.length}`;
        [...dots.children].forEach((d, k) => (k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      }

      if (slides.length > 1) {
        prev.hidden = next.hidden = count.hidden = false;
        prev.addEventListener('click', () => show(i - 1));
        next.addEventListener('click', () => show(i + 1));
        q('.stage').addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') show(i - 1);
          if (e.key === 'ArrowRight') show(i + 1);
        });
      }
      show(0);
    }
  </script>

  <!-- Video and news -->
  {media.length > 0 && (
    <section class="section" aria-labelledby="media-title">
      <div class="container">
        <div class="section-head">
          <h2 id="media-title">Video and news</h2>
          <a class="label" href={url('/media/')}>All media →</a>
        </div>
        <ul class="card-grid">
          {media.map((m) => (
            <li>
              <MediaCard
                href={url(`/media/${m.id}/`)}
                title={m.data.title}
                kind={m.data.kind}
                date={m.data.date}
                creator={m.data.creator}
                platform={m.data.platform}
                duration={m.data.duration}
                summary={m.data.summary}
                embedded={Boolean(m.data.youtube_id)}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Storm timeline -->
  <section class="section dark timeline-section" aria-labelledby="timeline-title">
    <div class="container">
      <div class="section-head">
        <h2 id="timeline-title">Storms of Belize</h2>
        <p class="meta">Hattie is the first chapter. Others may follow.</p>
      </div>
      <StormTimeline />
    </div>
  </section>

  <!-- About the project -->
  <section class="section" aria-labelledby="about-title">
    <div class="container about">
      <div class="section-head">
        <h2 id="about-title">About the project</h2>
      </div>
      <div class="about-grid">
        <div class="about-copy">
          <p class="lede">
            {SITE.name} records stories of Hurricane Hattie through the memories of those who experienced it. This is a
            public oral history project that creates a historical repository for Belizean stories. Browse the site and
            learn how you can <a href={url('/get-involved/')}>get involved</a>.
          </p>
          <p>
            This project exists as a way to collect the memories of our elders who witnessed and experienced the
            disastrous storm.
          </p>
          <p><a href={url('/about/')}>How we work: ethics and consent</a></p>
        </div>
        <dl class="about-facts">
          <div><dt class="label">Project lead</dt><dd><a href={SITE.projectLeadUrl} rel="noopener">{SITE.projectLead}</a></dd></div>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* At a glance */
  .glance {
    background: var(--white);
    border-bottom: 1px solid var(--rule);
    border-top: 4px solid var(--accent);
    padding-block: var(--space-7);
  }
  .glance-title { color: var(--accent); font-family: var(--font-mono); font-stretch: normal; font-size: var(--step--1); margin-bottom: var(--space-4); }
  .glance-grid { display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 52rem) {
    .glance-grid { grid-template-columns: minmax(0, 1fr) minmax(16rem, 19rem); }
  }
  .glance-text { font-size: var(--step-2); line-height: 1.4; color: var(--ink); max-width: 42rem; }
  .glance-text mark { background: none; color: var(--accent); font-weight: 700; }
  .gauge { background: var(--panel); border-top: 3px solid var(--ink); padding: var(--space-4) var(--space-4) var(--space-2); color: var(--ink); }
  .gauge svg { display: block; width: 100%; height: auto; }
  .gauge figcaption { font-size: var(--step--1); color: var(--muted); padding-top: var(--space-2); }
  .gauge .water { fill: #205B88; opacity: 0.18; }
  .gauge .wave { fill: none; stroke: #205B88; stroke-width: 3; }
  .gauge-num { font-family: var(--font-mono); font-size: 11px; fill: var(--muted); }
  .gauge-14 { font-family: var(--font-display); font-weight: var(--display-weight); font-size: 18px; fill: var(--accent); }

  /* Dark text band under At a glance */
  .band { padding-block: var(--space-7); border-bottom: 4px solid var(--accent); }
  .band-text { font-size: var(--step-2); line-height: 1.4; max-width: 46rem; font-weight: 500; color: var(--white); }

  /* About */
  .about-grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 52rem) {
    .about-grid { grid-template-columns: 2fr 1fr; }
  }
  .lede { font-size: var(--step-1); line-height: 1.5; }
  .about-copy > * + * { margin-top: var(--space-4); }
  .about-facts { display: grid; gap: var(--space-4); align-content: start; }
  .about-facts div { border-top: 1px solid var(--rule); padding-top: var(--space-2); }
  .about-facts dt { color: var(--muted); }
  .about-facts dd { margin-top: var(--space-1); font-weight: 600; justify-self: start; display: inline-block; }

  .panel { background: var(--panel); }

  /* Featured voices: warm background so it stands apart from the cool sections around it */
  .voices { background: var(--sand); border-block: 1px solid #E4CDB9; }
  .quote-mark { color: var(--accent); margin-right: var(--space-1); }
  .pending {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    padding: var(--space-6);
    border: 2px dashed var(--accent);
    background: rgba(255, 255, 255, 0.5);
  }
  .section-head a.label { color: var(--accent); min-height: var(--tap); display: inline-flex; align-items: center; }

  /* Cards */
  .card-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  /* Newsreel panel */
  .video-panel { padding-block: var(--space-7); }
  .video-panel figure { display: grid; gap: var(--space-5); align-items: center; }
  @media (min-width: 56rem) {
    .video-panel figure { grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); gap: var(--space-7); }
  }
  .frame { position: relative; aspect-ratio: 16 / 9; background: #0c171e; }
  .frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video-panel figcaption > * + * { margin-top: var(--space-3); }
  .panel-caption { font-size: var(--step-1); line-height: 1.5; color: var(--white); }

  /* Photographs: dark stage */
  .photos-stage .section-head a.label { color: var(--accent-on-ink); }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    height: min(62vh, 30rem);
    background: #0c171e;
  }
  .stage:focus-visible { outline: 3px solid var(--accent-on-ink); outline-offset: 2px; }
  .stage img { max-height: min(62vh, 30rem); max-width: 100%; object-fit: contain; }
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    border: 1px solid #5b6f78;
    background: rgba(18, 33, 43, 0.85);
    color: var(--white);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .arrow:hover { background: var(--accent); border-color: var(--accent); }
  .arrow[hidden] { display: none; }
  .arrow.prev { left: var(--space-3); }
  .arrow.next { right: var(--space-3); }
  .stage-cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-4);
  }
  .stage-cap > div > * + * { margin-top: var(--space-2); }
  .mono-line { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-on-ink); }
  .stage-title { font-weight: 600; color: var(--white); }
  .stage-text { max-width: 46rem; color: var(--on-ink); font-size: var(--step--1); line-height: 1.5; }
  .dots { display: flex; gap: var(--space-2); margin-top: var(--space-4); }
  .dots :global(button) {
    width: 2.25rem;
    height: 0.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .dots :global(button)::after { content: ''; position: absolute; left: 0; right: 0; top: 0.2rem; height: 0.35rem; background: #33464F; }
  .dots :global(button[aria-current='true'])::after { background: var(--accent-on-ink); }

  /* Process */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5) var(--space-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
  }
  .steps li { position: relative; }
  /* One continuous line runs behind the step markers. */
  .steps li::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    left: 0;
    right: calc(-1 * var(--space-7));
    height: 2px;
    background: var(--accent);
  }
  .steps li:last-child::before { right: 0; background: linear-gradient(to right, var(--accent) 3rem, transparent 3rem); }
  .step-marker { position: relative; display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
  .step-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--accent-on-ink);
    flex: none;
    box-shadow: 0 0 0 6px var(--panel);
  }
  .step-n { font-family: var(--font-mono); color: var(--accent); font-weight: 500; background: var(--panel); padding-inline: var(--space-2); position: relative; }
  .steps h3 { margin-bottom: var(--space-2); }
  .steps p { color: var(--muted); font-size: var(--step--1); line-height: 1.5; }
  .steps-note { margin-block: var(--space-6) var(--space-4); color: var(--muted); }
  @media (max-width: 47.99rem) {
    .steps li::before { display: none; }
  }

  .timeline-section { padding-bottom: var(--space-8); }
</style>
