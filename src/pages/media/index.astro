---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCard from '../../components/MediaCard.astro';
import { url } from '../../lib/url';
import { getMedia } from '../../lib/content';

const items = await getMedia();
---

<BaseLayout title="Media" section="media" description="Newsreels, news reports and other video about Hurricane Hattie.">
  <section class="section">
    <div class="container">
      <header class="page-head">
        <p class="eyebrow">The archive</p>
        <h1>Media</h1>
        <p class="lede">
          Newsreels and news reports about Hurricane Hattie, from footage filmed in 1961 to anniversary coverage. Each
          is credited to the people who made it and stays with its publisher; we embed or link to it rather than copy it.
        </p>
      </header>

      <p class="count label">{items.length} {items.length === 1 ? 'item' : 'items'}</p>

      {items.length > 0 ? (
        <ul class="media-grid">
          {items.map((m) => (
            <li>
              <MediaCard
                href={url(`/media/${m.id}/`)}
                title={m.data.title}
                kind={m.data.kind}
                date={m.data.date}
                creator={m.data.creator}
                platform={m.data.platform}
                duration={m.data.duration}
                summary={m.data.summary}
                embedded={Boolean(m.data.youtube_id)}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p>No media has been added yet.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { margin-bottom: var(--space-6); }
  .page-head h1 { margin-top: var(--space-2); }
  .lede { margin-top: var(--space-4); font-size: var(--step-1); line-height: 1.5; }
  .count { color: var(--muted); margin-bottom: var(--space-4); }
  .media-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
