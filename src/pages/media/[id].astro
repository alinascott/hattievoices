---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import Transcript from '../../components/Transcript.astro';
import { url } from '../../lib/url';
import { getMedia, getMediaTranscript, getStories, TESTIMONY_KIND, type Media } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getMedia();
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: Media };
const d = item.data;
// Survivor testimonies live under Listen; everything else under Media
const isTestimony = d.kind === TESTIMONY_KIND;
const { Content } = await render(item);
const hasBody = Boolean(item.body?.trim());
// Testimonies with a video can be viewed as the video or as a transcript
const transcript = await getMediaTranscript(item);
const showViews = isTestimony && Boolean(d.youtube_id);
const isArticle = d.format === 'article';
// e.g. "amandala.com.bz", shown on the button for written pieces
const site = new URL(d.url).hostname.replace(/^www\./, '');

const linked = new Set(d.related_stories.map((r) => r.id));
const stories = (await getStories()).filter((s) => linked.has(s.id));

const rows = [
  { label: 'Type', value: d.kind },
  { label: 'Date', value: d.date },
  { label: 'Made by', value: d.creator },
  { label: 'Published by', value: d.publisher },
  { label: d.format === 'article' ? 'Pages' : 'Length', value: d.duration },
  { label: 'Rights', value: d.rights },
  { label: 'Archive ID', value: item.id },
].filter((r) => r.value?.trim());
---

<BaseLayout title={d.title} section={isTestimony ? 'listen' : 'media'} description={d.summary}>
  <article class="container media-page">
    <nav class="crumbs label" aria-label="Breadcrumb">
      <a href={url(isTestimony ? '/stories/' : '/media/')}>{isTestimony ? 'Listen' : 'Media'}</a> <span aria-hidden="true">/</span> <span>{item.id}</span>
    </nav>

    <header class="head">
      <p class="eyebrow">{d.kind} · {d.date}</p>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
    </header>

    <div class="layout">
      <div class="main">
        {showViews && (
          <div class="views" role="group" aria-label="View this testimony as" data-views hidden>
            <span class="label views-label" aria-hidden="true">View</span>
            <button type="button" data-view="video" aria-pressed="true">Video</button>
            <button type="button" data-view="transcript" aria-pressed="false">
              Transcript{!transcript && <span class="soon"> · coming soon</span>}
            </button>
          </div>
        )}

        {d.youtube_id ? (
          <figure class="video" id="view-video" data-panel="video">
            <div class="frame">
              <!-- youtube-nocookie.com: YouTube's privacy-enhanced mode, no tracking cookies until play -->
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${d.youtube_id}?rel=0`}
                title={`${d.title} (video)`}
                loading="lazy"
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
            <figcaption class="meta">{d.credit} Played from YouTube.</figcaption>
          </figure>
        ) : (
          <div class="offsite card">
            <p class="label">{isArticle ? `Published at ${site}` : `Hosted on ${d.platform}`}</p>
            <p>
              {isArticle
                ? 'This piece belongs to its publisher and is not copied to this site. You can read it on their website.'
                : `This video belongs to its publisher and is not copied to this site. You can watch it on ${d.platform}.`}
            </p>
            <a class="btn" href={d.url} rel="noopener">
              {isArticle ? 'Read the article' : `Watch on ${d.platform}`} <span aria-hidden="true">↗</span>
              <span class="visually-hidden">(on another website)</span>
            </a>
            <p class="meta credit">{d.credit}</p>
          </div>
        )}

        {showViews && (
          <section class="transcript-panel" id="view-transcript" data-panel="transcript" aria-labelledby="transcript-title">
            <h2 id="transcript-title" class="panel-title">Transcript</h2>
            {transcript ? (
              <>
                <p class="meta panel-note">Select a time to play the video from that point.</p>
                <Transcript
                  transcript={transcript.data}
                  clips={[{ n: 1, title: d.title, start: '00:00' }]}
                  clipHeadings={false}
                />
              </>
            ) : (
              <div class="no-transcript card">
                <p class="label">Not available yet</p>
                <p>
                  A transcript of this testimony is being prepared. When it is ready it will appear here, so the
                  testimony can be read as well as watched.
                </p>
              </div>
            )}
          </section>
        )}

        {hasBody && <div class="body"><Content /></div>}
      </div>

      <aside class="details">
        <dl>
          {rows.map((r) => (
            <div>
              <dt class="label">{r.label}</dt>
              <dd>{r.value}</dd>
            </div>
          ))}
        </dl>
        {d.youtube_id && (
          <p class="also"><a href={d.url} rel="noopener">Open on YouTube <span aria-hidden="true">↗</span></a></p>
        )}
      </aside>
    </div>

    {stories.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <div class="section-head"><h2 id="related-title">Related oral histories</h2></div>
        <ul class="card-grid">
          {stories.map((s) => (
            <li>
              <StoryCard
                href={url(`/stories/${s.id}/`)}
                title={s.data.title}
                narrator={s.data.narrator.name}
                type={s.data.type}
                place={s.data.location_1961}
                languages={s.data.languages}
                summary={s.data.summary}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  // Video / Transcript switch on testimony pages. Without JavaScript both show, one after the other.
  const views = document.querySelector<HTMLElement>('[data-views]');
  if (views) {
    const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
    const buttons = [...views.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const iframe = document.querySelector<HTMLIFrameElement>('#view-video iframe');

    const show = (view: string, updateUrl = true) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== view));
      if (updateUrl) {
        const u = new URL(location.href);
        if (view === 'transcript') u.searchParams.set('view', 'transcript');
        else u.searchParams.delete('view');
        history.replaceState(null, '', u);
      }
    };

    views.hidden = false;
    show(new URLSearchParams(location.search).get('view') === 'transcript' ? 'transcript' : 'video', false);
    views.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-view]');
      if (b) show(b.dataset.view!);
    });

    // Selecting a time in the transcript switches to the video and plays from there
    document.addEventListener('hv:seek', (e) => {
      const { offset } = (e as CustomEvent<{ clip: number; offset: number }>).detail;
      if (!iframe) return;
      const u = new URL(iframe.src);
      u.searchParams.set('start', String(Math.floor(offset)));
      u.searchParams.set('autoplay', '1');
      iframe.src = u.toString();
      show('video');
      iframe.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>

<style>
  .media-page { padding-block: var(--space-5) var(--space-8); }
  .crumbs { color: var(--muted); margin-bottom: var(--space-5); display: flex; gap: var(--space-2); align-items: center; }
  .crumbs a { min-height: var(--tap); display: inline-flex; align-items: center; }
  .head h1 { margin-top: var(--space-2); font-size: var(--step-3); }
  .lede { margin-top: var(--space-4); font-size: var(--step-1); line-height: 1.5; }

  .layout { display: grid; gap: var(--space-6); margin-top: var(--space-6); align-items: start; }
  @media (min-width: 56rem) {
    .layout { grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr); gap: var(--space-7); }
  }

  .video { background: var(--white); border: 1px solid var(--rule); padding: var(--space-3); }
  .frame { position: relative; aspect-ratio: 16 / 9; background: var(--ink); }
  .frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video figcaption { padding-top: var(--space-3); }

  .offsite { border-top-color: var(--accent); display: grid; gap: var(--space-3); justify-items: start; }
  .offsite .label { color: var(--accent); }
  .offsite .credit { margin-top: var(--space-1); }

  .body { margin-top: var(--space-6); }

  /* Video / Transcript switch */
  .views { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
  .views[hidden] { display: none; }
  .views-label { color: var(--muted); margin-right: var(--space-1); }
  .views button {
    min-height: var(--tap);
    padding-inline: var(--space-4);
    background: var(--white);
    color: var(--text);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
  }
  .views button[aria-pressed='true'] { background: var(--ink); color: var(--white); }
  .views button:focus-visible { outline: var(--focus); outline-offset: 2px; }
  .soon { text-transform: none; letter-spacing: normal; color: var(--muted); }
  .views button[aria-pressed='true'] .soon { color: var(--on-ink); }
  [data-panel][hidden] { display: none; }

  .transcript-panel { margin-top: var(--space-6); }
  [data-views]:not([hidden]) ~ .transcript-panel { margin-top: 0; }
  .panel-title { font-size: var(--step-2); border-top: 4px solid var(--ink); padding-top: var(--space-3); margin-bottom: var(--space-3); }
  .panel-note { margin-bottom: var(--space-4); }
  .no-transcript { border-top-color: var(--accent); display: grid; gap: var(--space-2); }
  .no-transcript .label { color: var(--accent); }

  dl { border-top: 4px solid var(--ink); }
  dl div { display: grid; grid-template-columns: 8rem 1fr; gap: var(--space-3); padding-block: var(--space-3); border-bottom: 1px solid var(--rule); }
  dt { color: var(--muted); padding-top: 2px; }
  .also { margin-top: var(--space-4); }
  .also a { display: inline-flex; align-items: center; min-height: var(--tap); }

  .related { margin-top: var(--space-8); }
  .card-grid { list-style: none; padding: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
</style>
