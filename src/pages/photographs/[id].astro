---
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import PhotoCard from '../../components/PhotoCard.astro';
import Value from '../../components/Value.astro';
import { url } from '../../lib/url';
import { responsive, shareImage } from '../../lib/images';
import { getPhotos, getStories, type Photo } from '../../lib/content';

export async function getStaticPaths() {
  const photos = await getPhotos();
  return photos.map((photo) => {
    // Other photographs in the same collection, in archive-number order
    const set = photo.data.collection
      ? photos.filter((p) => p.data.collection === photo.data.collection).sort((a, b) => a.id.localeCompare(b.id))
      : [];
    return { params: { id: photo.id }, props: { photo, set } };
  });
}

const { photo, set } = Astro.props as { photo: Photo; set: Photo[] };
const pos = set.findIndex((p) => p.id === photo.id);
const prev = set.length > 1 ? set[(pos - 1 + set.length) % set.length] : undefined;
const next = set.length > 1 ? set[(pos + 1) % set.length] : undefined;
const collectionHref = photo.data.collection ? url(`/photographs/?collection=${encodeURIComponent(photo.data.collection)}`) : '';
const d = photo.data;
const { Content } = await render(photo);
const hasBody = Boolean(photo.body?.trim());
const img = responsive(d.image);
// Multi-page items: each page with its smaller copies
const pages = d.pages.map((pg) => ({ ...pg, img: responsive(pg.image), full: url(pg.image) }));
const share = shareImage(d.image, Astro.site);

// Stories linked from either side: the photo's related_stories, or a story's related_photos.
const linked = new Set(d.related_stories.map((r) => r.id));
const stories = (await getStories()).filter(
  (s) => linked.has(s.id) || s.data.related_photos.some((r) => r.id === photo.id),
);

// Size label for the optional full-resolution download
let download: { href: string; label: string } | undefined;
if (d.image_original) {
  const path = join('public', d.image_original);
  const ext = d.image_original.split('.').pop()?.toUpperCase() ?? 'file';
  const mb = existsSync(path) ? ` ${(statSync(path).size / 1_000_000).toFixed(1)} MB` : '';
  download = { href: url(d.image_original), label: `Download original (${ext}${mb ? ',' + mb : ''})` };
}

const rows: { label: string; value?: string; href?: string }[] = [
  { label: 'Date', value: d.date },
  { label: 'Creator', value: d.creator },
  { label: 'Held by', value: d.lender },
  { label: 'Source', value: d.source, href: d.source_url || undefined },
  { label: 'Collection', value: d.collection, href: collectionHref || undefined },
  { label: 'Original or copy', value: d.original_or_copy },
  { label: 'Rights', value: d.rights },
  { label: 'Archive ID', value: photo.id },
].filter((r) => r.value?.trim());
---

<BaseLayout title={d.title} section="photographs" description={d.caption} image={share} imageAlt={d.alt} type="article">
  <article class="container photo-page">
    <nav class="crumbs label" aria-label="Breadcrumb">
      <a href={url('/photographs/')}>Photographs</a> <span aria-hidden="true">/</span> <span>{photo.id}</span>
    </nav>

    <div class="layout">
      <figure class="figure">
        <a class="image-link" href={url(d.image)} aria-label={`Open the full-size image: ${d.title}`}>
          <img {...img} sizes="(min-width: 56rem) 55vw, 100vw" alt={d.alt} />
        </a>
        <figcaption>
          <p>{d.caption}</p>
          {d.credit && <p class="credit">{d.credit}</p>}
          {pages.length > 0 && <p class="read-all"><a href="#pages">Read all {pages.length} pages <span aria-hidden="true">↓</span></a></p>}
        </figcaption>
      </figure>

      <div class="details">
        <h1>{d.title}</h1>
        {hasBody && <div class="body"><Content /></div>}

        <dl>
          {rows.map((r) => (
            <div>
              <dt class="label">{r.label}</dt>
              <dd>
                {r.href ? <a href={r.href} rel="noopener">{r.value}</a> : <Value value={r.value} />}
              </dd>
            </div>
          ))}
        </dl>

        {d.explore_url && (
          <p class="explore">
            <a class="btn" href={d.explore_url} rel="noopener">
              {d.explore_label || 'Explore the full item'} <span aria-hidden="true">↗</span>
              <span class="visually-hidden">(on another website)</span>
            </a>
          </p>
        )}

        <p class="actions">
          <a class="btn btn-ghost" href={url(d.image)}>View full size</a>
          {download && <a class="btn btn-ghost" href={download.href} download>{download.label}</a>}
        </p>

        <p class="meta lend">
          Do you know more about this photograph, or have others like it?
          <a href={url('/get-involved/?path=photos')}>Tell us</a>.
        </p>
      </div>
    </div>

    {pages.length > 0 && (
      <section class="related pages" id="pages" aria-labelledby="pages-title">
        <div class="section-head">
          <h2 id="pages-title">All {pages.length} pages</h2>
          <span class="label muted">Tap a page to open it full size</span>
        </div>
        <ol class="page-stack">
          {pages.map((pg, i) => (
            <li>
              <figure>
                <figcaption class="label muted">{pg.label} <span aria-hidden="true">·</span> {i + 1} of {pages.length}</figcaption>
                <a href={pg.full} aria-label={`Open ${pg.label} full size`}>
                  <img {...pg.img} sizes="(min-width: 50rem) 46rem, 100vw" alt={pg.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </a>
              </figure>
            </li>
          ))}
        </ol>
        <p class="back-top"><a href="#main">Back to top <span aria-hidden="true">↑</span></a></p>
      </section>
    )}

    {set.length > 1 && (
      <section class="related collection" aria-labelledby="collection-title">
        <div class="section-head">
          <div>
            <p class="label muted">More from this collection</p>
            <h2 id="collection-title">{d.collection}</h2>
          </div>
          <a class="label" href={collectionHref}>See all {set.length} →</a>
        </div>
        <nav class="pager" aria-label="Within this collection">
          <a class="btn btn-ghost" href={url(`/photographs/${prev!.id}/`)} rel="prev">
            <span aria-hidden="true">←</span> <span class="pager-text"><span class="label">Previous</span> <span class="pager-title">{prev!.data.title}</span></span>
          </a>
          <p class="label muted pos">{pos + 1} of {set.length}</p>
          <a class="btn btn-ghost next" href={url(`/photographs/${next!.id}/`)} rel="next">
            <span class="pager-text"><span class="label">Next</span> <span class="pager-title">{next!.data.title}</span></span> <span aria-hidden="true">→</span>
          </a>
        </nav>
        <ul class="photo-grid">
          {set.filter((p) => p.id !== photo.id).map((p) => (
            <li>
              <PhotoCard href={url(`/photographs/${p.id}/`)} image={p.data.image} title={p.data.title} date={p.data.date} />
            </li>
          ))}
        </ul>
      </section>
    )}

    {stories.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <div class="section-head">
          <h2 id="related-title">Related oral histories</h2>
        </div>
        <ul class="card-grid">
          {stories.map((s) => (
            <li>
              <StoryCard
                href={url(`/stories/${s.id}/`)}
                title={s.data.title}
                narrator={s.data.narrator.name}
                type={s.data.type}
                place={s.data.location_1961}
                languages={s.data.languages}
                summary={s.data.summary}
              />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .photo-page { padding-block: var(--space-5) var(--space-8); }
  .crumbs { color: var(--muted); margin-bottom: var(--space-5); display: flex; gap: var(--space-2); align-items: center; }
  .crumbs a { min-height: var(--tap); display: inline-flex; align-items: center; }

  .layout { display: grid; gap: var(--space-6); align-items: start; }
  @media (min-width: 56rem) {
    .layout { grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 1fr); gap: var(--space-7); }
  }

  .figure { background: var(--white); border: 1px solid var(--rule); padding: var(--space-3); }
  .image-link { display: block; }
  .figure img { width: 100%; height: auto; max-height: 85vh; object-fit: contain; background: var(--panel); }
  figcaption { padding-top: var(--space-3); font-size: var(--step--1); color: var(--muted); }
  figcaption .credit { margin-top: var(--space-1); font-family: var(--font-mono); font-size: 0.8rem; }

  .details h1 { font-size: var(--step-3); }
  .body { margin-top: var(--space-4); }
  dl { margin-top: var(--space-5); border-top: 4px solid var(--ink); }
  dl div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }
  dt { color: var(--muted); padding-top: 2px; }
  .explore { margin-top: var(--space-5); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .explore + .actions { margin-top: var(--space-3); }
  .lend { margin-top: var(--space-5); }

  .related { margin-top: var(--space-8); }
  .read-all { margin-top: var(--space-2); font-weight: 600; }
  .page-stack { list-style: none; padding: 0; display: grid; gap: var(--space-6); max-width: 46rem; margin-inline: auto; }
  .page-stack figure { background: var(--white); border: 1px solid var(--rule); padding: var(--space-3); }
  .page-stack figcaption { margin-bottom: var(--space-2); }
  .page-stack img { width: 100%; height: auto; display: block; }
  .pages .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-2); border-top: 4px solid var(--ink); padding-top: var(--space-3); }
  .back-top { text-align: center; margin-top: var(--space-5); }
  .collection .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-3); border-top: 4px solid var(--ink); padding-top: var(--space-3); }
  .collection h2 { font-size: var(--step-2); margin-top: var(--space-1); }
  .muted { color: var(--muted); }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--space-3); align-items: center; margin-block: var(--space-5); }
  .pager .btn { display: flex; align-items: center; gap: var(--space-2); text-align: left; min-width: 0; }
  .pager .next { justify-content: flex-end; text-align: right; }
  .pager-text { display: flex; flex-direction: column; min-width: 0; }
  .pager-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-transform: none;
    letter-spacing: normal;
    font-family: var(--font-body);
    font-weight: 600;
    line-height: 1.3;
  }
  .pager-text .label { font-size: 0.7rem; }
  .pos { text-align: center; }
  @media (max-width: 40rem) {
    .pager { grid-template-columns: 1fr 1fr; }
    .pos { grid-column: 1 / -1; grid-row: 1; }
  }
  .photo-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .card-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
</style>
