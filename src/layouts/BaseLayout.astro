---
import '../styles/fonts.css';
import '../styles/global.css';
// The two fonts every page uses straight away, preloaded so text appears in them sooner
import bodyFont from '../assets/fonts/ibm-plex-sans-normal-400-latin.woff2?url';
import displayFont from '../assets/fonts/archivo-normal-600-800-latin.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BridgeIntro from '../components/BridgeIntro.astro';
import { SITE } from '../config';
import { url } from '../lib/url';
import { shareImage } from '../lib/images';

interface Props {
  title?: string;
  description?: string;
  /** Lets the header mark the current section in the nav. */
  section?: 'listen' | 'photographs' | 'media' | 'about' | 'get-involved';
  /** Keep the page out of search results (e.g. the form's thank-you page). */
  noindex?: boolean;
  /** Show the content advisory and swing bridge intro (homepage, first visit only). */
  intro?: boolean;
  /** Picture shown when the page is shared (from shareImage()). Defaults to the homepage aerial photograph. */
  image?: { src: string; width: number; height: number };
  imageAlt?: string;
  /** Open Graph type: 'article' for individual records, 'website' otherwise. */
  type?: 'website' | 'article';
}

const { title, description = SITE.description, section, noindex = false, intro = false, type = 'website' } = Astro.props;
const DEFAULT_ALT = 'Aerial photograph of Belize City after Hurricane Hattie, 1961.';
const share = Astro.props.image ?? shareImage('/images/belize-city-aerial-1962-hero.jpg', Astro.site);
const shareAlt = Astro.props.image ? (Astro.props.imageAlt ?? '') : DEFAULT_ALT;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />
    {noindex && <meta name="robots" content="noindex" />}
    {intro && (
      <script is:inline>
        // Decide before the first paint whether the content advisory and swing bridge intro show
        // (see BridgeIntro.astro). First visit only; with reduced motion it shows without moving.
        try {
          if (!localStorage.getItem('hv-bridge-intro-seen')) {
            document.documentElement.classList.add('bridge-intro');
            if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('bridge-intro-still');
          }
        } catch (e) {}
      </script>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    {share && (
      <>
        <meta property="og:image" content={share.src} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(share.width)} />
        <meta property="og:image:height" content={String(share.height)} />
        {shareAlt && <meta property="og:image:alt" content={shareAlt} />}
      </>
    )}
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#12212B" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    {intro && <BridgeIntro />}
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={section} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
