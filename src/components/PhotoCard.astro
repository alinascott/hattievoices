---
interface Props {
  href: string;
  image: string;
  title: string;
  date?: string;
  alt?: string;
}
const { href, image, title, date, alt = '' } = Astro.props;
---

<figure class="photo-card">
  <a href={href}>
    <div class="frame"><img src={image} alt={alt} loading="lazy" decoding="async" /></div>
    <figcaption>
      <span class="title">{title}</span>
      {date && <span class="meta">{date}</span>}
    </figcaption>
  </a>
</figure>

<style>
  .photo-card a {
    display: block;
    color: var(--text);
    text-decoration: none;
    background: var(--white);
    border: 1px solid var(--rule);
    padding: var(--space-3);
  }
  .frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--panel);
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-3);
  }
  .title { font-weight: 600; line-height: 1.3; }
  .photo-card a:hover .title { text-decoration: underline; }
</style>
